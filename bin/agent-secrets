#!/usr/bin/env bash
# bin/agent-secrets — verb dispatcher. Do not edit by hand: the case table is the stable routing surface.
# Command behavior lives in cmd/*.sh + lib/*.sh; this file only routes.
# Names-only: this dispatcher never handles or prints a secret value.
set -euo pipefail

# --- Resolve own install root (follow symlinks) so cmd/ and lib/ are locatable ---
_self="${BASH_SOURCE[0]:-$0}"
while [ -h "$_self" ]; do
  _d=$(cd -P "$(dirname "$_self")" >/dev/null 2>&1 && pwd)
  _self=$(readlink "$_self")
  case "$_self" in /*) : ;; *) _self="$_d/$_self" ;; esac
done
AGENT_SECRETS_BIN=$(cd -P "$(dirname "$_self")" >/dev/null 2>&1 && pwd)
AGENT_SECRETS_ROOT=$(dirname "$AGENT_SECRETS_BIN")
AGENT_SECRETS_LIB="$AGENT_SECRETS_ROOT/lib"
AGENT_SECRETS_CMD="$AGENT_SECRETS_ROOT/cmd"
export AGENT_SECRETS_ROOT AGENT_SECRETS_LIB AGENT_SECRETS_CMD

# --- Leading global flags (before the verb). --plain is exported so the exec'd ---
# --- cmd re-sources common.sh in plain mode (NO_COLOR parity). --------
# --version is only recorded here: it is answered after help interception, so `<verb> --help` wins.
_want_version=0; _version_dep=0; _json_seen=0
while [ "${1:-}" != "" ]; do
  case "$1" in
    --plain)     export AGENT_SECRETS_PLAIN=1; shift ;;
    --no-color)  export NO_COLOR=1; shift ;;
    --non-interactive) export AGENT_SECRETS_NONINTERACTIVE=1; shift ;;
    -V)          _want_version=1; _version_dep=1; shift ;;   # hidden deprecated alias of --version
    -v|--version) _want_version=1; shift ;;
    *) break ;;
  esac
done

# --- Global flags AFTER the verb (`doctor --plain`) -----------------------------
# The loop above only sees flags BEFORE the verb; a trailing one would reach the cmd script and die
# in its arg loop. Strip them here — exported, never forwarded — so no cmd script sees one. The scan
# stops at `--`, leaving `run -- <cmd> --plain` to hand --plain to the CHILD (the seam _wants_help
# honors below). Must precede common.sh: that file fixes the color vars at source time.
_argc=$#; _past_dd=0
while [ "$_argc" -gt 0 ]; do
  _arg="$1"; shift; _argc=$((_argc - 1))
  if [ "$_past_dd" -eq 0 ]; then
    case "$_arg" in
      --)         _past_dd=1 ;;
      --plain)    export AGENT_SECRETS_PLAIN=1; continue ;;
      --no-color) export NO_COLOR=1; continue ;;
      --non-interactive) export AGENT_SECRETS_NONINTERACTIVE=1; continue ;;
      -V)         _want_version=1; _version_dep=1; continue ;;
      -v|--version) _want_version=1; continue ;;
      --json)     _json_seen=1 ;;   # noted, still forwarded: the verb owns its own --json
    esac
  fi
  set -- "$@" "$_arg"
done

# shellcheck source=lib/common.sh
. "$AGENT_SECRETS_LIB/common.sh"
# shellcheck source=lib/help.sh
. "$AGENT_SECRETS_LIB/help.sh"

usage() { agsec_help_render top; }   # single source of truth: lib/help.sh

# True if a help flag appears BEFORE any `--` separator — intercepts `<verb> --help` before the
# verb's body runs (critical: `uninstall --help` must never start removal), while leaving
# `run -- <cmd> --help` alone (there `--help` belongs to the child command).
_wants_help() { local a; for a in "$@"; do case "$a" in --) return 1 ;; -h|--help) return 0 ;; esac; done; return 1; }
# True if FLAG appears before any `--` (same seam as _wants_help).
_has_flag() { local f="$1" a; shift; for a in "$@"; do case "$a" in --) return 1 ;; "$f") return 0 ;; esac; done; return 1; }

_print_version() {
  if [ "$_json_seen" = 1 ]; then
    AGSEC_OUTPUT=json
    [ "$_version_dep" = 0 ] || agsec_deprecated -V --version
    printf '{"version":"%s"%s}\n' "$(agsec_js "$AGENT_SECRETS_VERSION")" \
      "${AGSEC_WARNINGS:+,\"warnings\":[$AGSEC_WARNINGS]}" | agsec_json_out
  else
    # The version line comes first: callers prefix-match it with the streams merged.
    printf 'agent-secrets %s\n' "$AGENT_SECRETS_VERSION"
    [ "$_version_dep" = 0 ] || agsec_deprecated -V --version
  fi
  exit 0
}

_reserved() {  # v0.1 stub for verbs deferred to v0.2
  printf '%s\n' "agent-secrets: '$1' is reserved for v0.2 and not available in ${AGENT_SECRETS_VERSION}." >&2
  case "$1" in
    rotate) printf '%s\n' "  For now: manifest 'rotate_by' rows + the weekly smoke job track rotation due-dates." >&2 ;;
    demo)   printf '%s\n' "  For now: set AGENT_SECRETS_HOME to a synthetic dir for isolated demos/tests." >&2 ;;
  esac
  exit 2
}

_dispatch() {  # exec the verb's script with remaining args; process-clean
  local script="$AGENT_SECRETS_CMD/$1.sh"; shift
  [ -f "$script" ] || agsec_die "internal: missing command script for '$(basename "$script" .sh)'"
  exec bash "$script" "$@"
}

_verb_given=0; [ "$#" -gt 0 ] && _verb_given=1
verb="${1:-help}"; [ "$#" -gt 0 ] && shift || true

# Per-command help interception — render help and exit WITHOUT running the command body.
case "$verb" in
  setup|add|list|ls|run|doctor|uninstall|share|receive|pubkey|backup)
    if _wants_help "$@"; then
      hv="$verb"; [ "$hv" = ls ] && hv=list
      if _has_flag --json "$@"; then
        agsec_help_json | jq -c --arg v "$hv" '.commands[]|select(.name==$v)' | agsec_json_out
      else
        agsec_help_render "$hv"
      fi
      exit 0
    fi ;;
  smoke)   # not via agsec_help_render (smoke is not in AGSEC_VERBS, which keeps it hidden)
    if _wants_help "$@"; then
      printf '%s\n' 'Usage: agent-secrets smoke' '' 'Hidden maintenance check (launchd job com.agent-secrets.smoke). Exits 0 if all pass, 1 on failure, 2 on usage error. Names only.'
      exit 0
    fi ;;
esac

# `help --version` is a help request too, so help wins there as well.
if [ "$_want_version" = 1 ]; then
  case "$_verb_given:$verb" in 1:help|1:--help|1:-h) : ;; *) _print_version ;; esac
fi

case "$verb" in
  setup)          _dispatch setup "$@" ;;
  add)            _dispatch add "$@" ;;
  list|ls)        _dispatch list "$@" ;;
  run)            _dispatch run "$@" ;;
  doctor)         _dispatch doctor "$@" ;;
  uninstall)      _dispatch uninstall "$@" ;;
  share)          _dispatch share "$@" ;;
  receive)        _dispatch receive "$@" ;;
  pubkey)         _dispatch pubkey "$@" ;;
  backup)         _dispatch backup "$@" ;;
  rotate)         _reserved rotate ;;
  demo)           _reserved demo ;;
  smoke)          _dispatch smoke "$@" ;;                  # hidden maintenance verb — the launchd weekly job runs it (kept out of help on purpose)
  --json)         agsec_help_json ;;                       # machine-readable manifest (agents)
  help|--help|-h)
    if [ "${1:-}" = search ]; then                         # `help search <TEXT> [--json]`
      shift
      # shellcheck source=lib/help_search.sh
      . "$AGENT_SECRETS_LIB/help_search.sh"
      agsec_help_search "$@"
    elif _has_flag --all "$@"; then                         # the CLI is flat: "all" is the top level
      if _has_flag --json "$@"; then agsec_help_json; else agsec_help_render top; fi
    else
      case "${1:-}" in
        --json)     agsec_help_json ;;                     # `help --json`
        '')         agsec_help_render top ;;
        *)          agsec_help_render "$1" ;;              # `help <command>`
      esac
    fi ;;
  *)              agsec_die "unknown command: '$verb' (try: agent-secrets help)" 2 ;;
esac
